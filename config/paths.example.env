# Paths to data, outputs and builds for every script in this repository.
# Copy this file to config/paths.env (not tracked by git) and edit it; the scripts read paths.env if it exists,
# otherwise this file. Any key can also be overridden by an environment variable of the same name.
# Write paths as absolute paths or starting with "~" (expanded); $VARIABLES are not expanded.
# Per-dataset overrides are possible: BB_FPS_<DS> / BB_SCAF_<DS> (DS = CHEMBL34, SCU, ENA1M, C35, NP) point at one
# fingerprint or scaffold-id file directly.

# --- Results folder ---
# Tables and figures go to results_<BB_RESULTS_NAME>/ in the repository (data/ and plots/). The default is the results
# that come with the repository. Change this to a short description of your machine or run (letters, digits, "_")
# to get your own results folder with the same structure.
BB_RESULTS_NAME=gb300_72coreARM

# --- Data inputs (see docs/DATA.md) ---
# Root of the prepared datasets: chembl34/, scubidoo/, enamine_real_10m/ (with subset_1m/), chembl35_new/,
# chembl33_np/, zinc20ml/, moleculeace/<set>/
BB_DATA=~/bitbirch-data
# Active (molecule, target) pairs from ChEMBL35, made by scripts/data/chembl_actives.py (for the target measures)
BB_ACTIVES=~/bitbirch-data/chembl35/actives.tsv.gz

# --- Outputs ---
# Labels, metric CSVs, timing inputs and logs written by the run scripts (large; keep outside the repository)
BB_OUT=~/bitbirch-out
# Refinement experiment: labels, work files and working figures (its tables go to data/refinement of the results folder)
BB_REFINE_POST_LABELS=~/bitbirch-out/refine_post

# --- Builds (see setup/SETUP.md; BUILD is the folder used by setup/fetch_and_build.sh) ---
# nvMolKit main 763b923: Python overlay folder with the nvmolkit package and its built .so files
BB_NVMOLKIT_PY=~/bitbirch-build/py-main
# bblean branch cpp-tree a2deb39, built in place (bblean serial and bblean split-merge)
BB_BBLEAN_TREE=~/bitbirch-build/bblean-cpp-tree
# bblean branch cpp-tree-batched bdad1b3, built in place with bblean's default flags (bblean batched)
BB_BBLEAN_BATCHED=~/bitbirch-build/bblean-tree-batched
# bblean 0.10.3 itself is the package installed in the conda environment (no path needed)

# --- Optional: earlier runs reused by the example results (leave as is if you do not have them) ---
# Earlier labels at the same settings (bblean 0.10.3 and an nvMolKit development build; same layout as BB_OUT/labels)
BB_BP_LABELS=~/bitbirch-earlier/labels
# Refinement experiment tables kept elsewhere (used only when data/refinement of the results folder has none)
BB_REFINE_CSV=~/bitbirch-out/refine_post/csv
# Earlier check of bblean batched against nvMolKit (batched_results.csv)
BB_BBLEAN_PORT=~/bitbirch-earlier/bblean_port
# ZINC22 run (12.16 billion molecules): only needed to re-export data/zinc22 of the results folder from a ZINC22 run
# with scripts/data/zinc22_export.py (pass these two folders to it); the figure scripts read data/zinc22.
# Metric results of the clustering
BB_GIANT_METRICS=~/bitbirch-earlier/zinc22/metrics
# Fingerprint folder (threshold.json, shards/, cluster_k3.5_bf1024/)
BB_ZINC22_FP=~/bitbirch-data/zinc22_2d_fp
